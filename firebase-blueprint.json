        },
        "eventOwnerId": {
          "type": "string",
          "description": "UID of the parent event owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "description": "UID of the user who created the item.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "timeSlot": {
          "type": "string",
          "description": "Scheduled time or lead-time milestone label.",
          "minLength": 1,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "description": "Milestone or run-of-show activity title.",
