        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "eventId",
        "eventOwnerId",
        "authorId",
        "timeSlot",
        "title",
        "phase",
        "leadPerson",
        "status",
        "notes",
        "collaboratorUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "VendorItem": {
      "title": "VendorItem",
