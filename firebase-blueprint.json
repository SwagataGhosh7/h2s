        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "eventId",
        "eventOwnerId",
        "authorId",
        "guestName",
        "partySize",
        "rsvpStatus",
        "tableGroup",
        "dietaryNotes",
        "collaboratorUids",
        "createdAt",
        "updatedAt"
      ]
    },
