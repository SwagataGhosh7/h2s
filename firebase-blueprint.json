{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Planner profile settings and studio metadata (isolated per user, no sensitive PII).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public planner or host display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "studioTitle": {
          "type": "string",
          "description": "Role or studio title (e.g. Executive Event Producer).",
          "minLength": 1,
          "maxLength": 100
        },
        "specialty": {
          "type": "string",
          "description": "Primary event specialization.",
          "enum": ["wedding", "birthday", "community"]
        },
        "locationCity": {
          "type": "string",
          "description": "Primary city or region (non-sensitive).",
          "minLength": 0,
          "maxLength": 100
        },
        "bio": {
          "type": "string",
          "description": "Planner bio and creative philosophy.",
          "minLength": 0,
          "maxLength": 400
        },
        "preferredCurrency": {
          "type": "string",
          "description": "Preferred display currency code.",
          "enum": ["USD", "EUR", "GBP"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "userId",
        "displayName",
        "studioTitle",
        "specialty",
        "locationCity",
        "bio",
        "preferredCurrency",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventPlan": {
      "title": "EventPlan",
      "description": "Core celebration or event record (wedding, birthday, or community event).",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Name of the celebration or event.",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Category of celebration.",
          "enum": ["wedding", "birthday", "community"]
        },
        "eventDate": {
          "type": "string",
          "description": "ISO date string for the event.",
          "minLength": 8,
          "maxLength": 32
        },
        "location": {
          "type": "string",
          "description": "Venue or city name.",
          "minLength": 2,
          "maxLength": 140
        },
        "guestCountEstimate": {
          "type": "number",
          "description": "Estimated number of guests."
        },
        "totalBudgetLimit": {
          "type": "number",
          "description": "Total target budget in USD."
        },
        "styleBrief": {
          "type": "string",
          "description": "Aesthetic direction, mood, and vision notes.",
          "minLength": 0,
          "maxLength": 600
        },
        "inviteCode": {
          "type": "string",
          "description": "Short alphanumeric code used for team/guest collaboration.",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Lifecycle status of the event.",
          "enum": ["planning", "locked", "archived"]
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the event creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the event creator.",
          "minLength": 1,
          "maxLength": 80
        },
        "collaboratorUids": {
          "type": "array",
          "description": "Bounded list (max 10) of collaborator UIDs with access to this event."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "title",
        "category",
        "eventDate",
        "location",
        "guestCountEstimate",
        "totalBudgetLimit",
        "styleBrief",
        "inviteCode",
        "status",
        "ownerId",
        "ownerName",
        "collaboratorUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventMember": {
      "title": "EventMember",
      "description": "Collaborator or guest membership record under an event.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Parent event ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventOwnerId": {
          "type": "string",
          "description": "Owner UID of the parent event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Authenticated user UID of the member.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the collaborator or guest.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Role in the event workspace.",
          "enum": ["owner", "planner", "guest"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when joined."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "eventId",
        "eventOwnerId",
        "userId",
        "displayName",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "BudgetItem": {
      "title": "BudgetItem",
      "description": "Budget line item tracking estimated and actual spend.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Parent event ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventOwnerId": {
          "type": "string",
          "description": "UID of the parent event owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "description": "UID of the user who created the item.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Expense item title.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Budget category.",
          "enum": ["venue", "catering", "decor", "music", "attire", "logistics"]
        },
        "estimatedAmount": {
          "type": "number",
          "description": "Planned cost in USD."
        },
        "actualAmount": {
          "type": "number",
          "description": "Committed or paid cost in USD."
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment state of this budget line.",
          "enum": ["planned", "deposit_paid", "paid_in_full"]
        },
        "notes": {
          "type": "string",
          "description": "Additional context or vendor quote notes.",
          "minLength": 0,
          "maxLength": 300
        },
        "collaboratorUids": {
          "type": "array",
          "description": "Bounded list (max 10) of collaborator UIDs synced from event."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "eventId",
        "eventOwnerId",
        "authorId",
        "title",
        "category",
        "estimatedAmount",
        "actualAmount",
        "paymentStatus",
        "notes",
        "collaboratorUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "TimelineItem": {
      "title": "TimelineItem",
