  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Individual planner profile documents isolated strictly to the profile owner."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/EventPlan" },
      "description": "Primary event plans created by users and shared with up to 10 collaborators."
    },
    "/events/{eventId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/EventMember" },
      "description": "Subcollection of team members and guests participating in an event."
    },
    "/events/{eventId}/budgetItems/{itemId}": {
      "schema": { "$ref": "#/entities/BudgetItem" },
      "description": "Subcollection of budget line items for an event."
    },
    "/events/{eventId}/timelineItems/{itemId}": {
      "schema": { "$ref": "#/entities/TimelineItem" },
      "description": "Subcollection of production timeline milestones and run-of-show cues."
    },
    "/events/{eventId}/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/VendorItem" },
      "description": "Subcollection of vendor checklists, quotes, and contract statuses."
    },
    "/events/{eventId}/guests/{guestId}": {
      "schema": { "$ref": "#/entities/GuestEntry" },
      "description": "Subcollection of guest RSVP entries and seating groups."
    },
    "/events/{eventId}/ideas/{ideaId}": {
      "schema": { "$ref": "#/entities/IdeaCard" },
      "description": "Subcollection of AI-generated and team-curated event concept cards."
    },
    "/events/{eventId}/collabNotes/{noteId}": {
      "schema": { "$ref": "#/entities/CollabNote" },
      "description": "Subcollection of real-time team and guest collaboration notes."
    }
  }
}
