        }
      },
      "required": [
        "eventId",
        "eventOwnerId",
        "authorId",
        "vendorName",
        "serviceType",
        "contractStatus",
        "quotedPrice",
        "contactPerson",
        "deliverableNotes",
        "collaboratorUids",
        "createdAt",
        "updatedAt"
      ]
    },
